{% raw %}name: Build and Deploy Application
on:
  push:
    branches: [main]
    paths:
      [".github/workflows/startup.yml",
        'backend/**',
        'frontend/**',
        'shared/**',
        'scripts/**',
        'tests/**',
        'e2e_tests/**',
        'package*.json',
        '*config*',
        'make.sh',
        '.prettier*',
        '.github/workflows/build-and-deploy-backend.yml',
      ]
  pull_request:
  workflow_dispatch:
# Superseded PR checks can stop; pushes and manual deployments keep independent runs.
concurrency:
  group: pr-${{ github.workflow }}-${{ github.event.pull_request.number || github.run_id }}
  cancel-in-progress: ${{ github.event_name == 'pull_request' }}

jobs:
  application:
    uses: ./.github/workflows/startup.yml
    permissions:
      contents: read
      actions: read
      pull-requests: write
      packages: write
      id-token: write
    with:
      operation: build
      environment: production
      service: backend
      additional_build_context: application=.
      run_lint: true
      run_tests: true
      run_e2e: true
    secrets:
      VAULT_PASSWORD: ${{ secrets.VAULT_PASSWORD }}
{% endraw %}
