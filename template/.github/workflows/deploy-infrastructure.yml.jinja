{% raw %}name: Deploy Infrastructure

on:
  workflow_dispatch:
    inputs:
      environment:
        description: 'Environment which infrastructure should be deployed'
        required: true
        default: 'production'
        type: choice
        options:
          - production

jobs:
  deploy-infrastructure:
    uses: {% endraw %}{{ github_username }}{% raw %}/{% endraw %}{{ deploy_repo_name }}{% raw %}/.github/workflows/deploy-infrastructure.yml@{% endraw %}{{ deploy_ref }}{% raw %}
    with:
      environment: ${{ github.event.inputs.environment || inputs.environment }}
    secrets:
      VAULT_PASSWORD: ${{ secrets.VAULT_PASSWORD }}
{% endraw %}