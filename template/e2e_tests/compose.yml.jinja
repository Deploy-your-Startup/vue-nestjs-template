services:
  db:
    image: postgres:{{ postgres_version }}
    environment:
      POSTGRES_USER: admin
      POSTGRES_PASSWORD: admin
      POSTGRES_DB: e2e
    tmpfs:
      - /var/lib/postgresql
    healthcheck:
      test: ['CMD-SHELL', 'pg_isready -U admin -d e2e']
      interval: 1s
      timeout: 5s
      retries: 60
  test:
    image: ${E2E_IMAGE:?Build the E2E image first}
    depends_on:
      db:
        condition: service_healthy
    environment:
      CI: 'true'
      TEST_DATABASE_URL: postgres://admin:admin@db:5432/e2e
      E2E_CONTAINER: 'true'
    shm_size: 1gb
