{
  "name": {{ project_name | to_json }},
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.backend.json",
    "start": "node dist/backend/migrate.js && node dist/backend/main.js",
    "db:up": "docker compose up -d --wait db",
    "db:stop": "docker compose stop db",
    "db:migrate": "node dist/backend/migrate.js",
    "dev": "node scripts/dev.mts",
    "format": "prettier --write .",
    "lint": "prettier --check . && tsc --noEmit -p tsconfig.backend.json && vue-tsc --noEmit -p tsconfig.frontend.json && tsc --noEmit -p tsconfig.tools.json",
    "test": "npm run build && node scripts/test.mts",
    "test:e2e": "npm test"
  },
  "dependencies": {
    "@nestjs/typeorm": "12.0.2",
    "typeorm": "0.3.31",
    "pg": "8.23.1",
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-express": "12.3.2",
    "@nestjs/serve-static": "12.1.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "vue": "3.5.44",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/pg": "8.15.6",
    "@types/node": "24.10.1",
    "@vitejs/plugin-vue": "6.0.10",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vue-tsc": "3.1.4"
  }
}
